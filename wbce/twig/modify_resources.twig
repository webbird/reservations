{#
    reservations/twig/modify_resources.twig – objects of a section
#}
<div class="mod_reservations">
    <p class="rsv-toolbar"><a href="{{ url_settings }}">{{ t('SETTINGS') }}</a> | <a href="{{ url_statuses }}">{{ t('STATUSES') }}</a> | <a href="{{ url_types }}">{{ t('TYPES') }}</a> | {% include '_help_link.twig' with {page: 'objects'} %}</p>
    {% include '_messages.twig' %}

    <table class="rsv-table">
        <caption>{{ t('RESOURCES') }}</caption>
        <thead>
            <tr>
                <th scope="col">{{ t('TITLE') }}</th>
                <th scope="col">{{ t('TYPE') }}</th>
                <th scope="col" class="rsv-num">{{ t('POSITION') }}</th>
                {% if news %}<th scope="col">{{ t('DESCRIPTION') }}</th>{% endif %}
                <th scope="col">{{ t('ACTIVE') }}</th>
                <th scope="col" class="rsv-num">{{ t('BOOKINGS_CURRENT') }}</th>
                <th scope="col" class="rsv-num">{{ t('REQUESTS_OPEN') }}</th>
                <th scope="col"><span class="rsv-sr">{{ t('ACTIONS') }}</span></th>
            </tr>
        </thead>
        <tbody>
        {% for r in resources %}
            <tr{% if not r.active %} class="rsv-inactive"{% endif %}>
                <th scope="row">{{ r.title }}</th>
                <td>{{ r.type }}</td>
                <td class="rsv-num">{{ r.position }}</td>
                {% if news %}
                    <td>{{ r.description is same as(false) ? t('DESCRIPTION_ORPHANED') : r.description }}</td>
                {% endif %}
                <td>{{ r.active ? t('YES') : t('NO') }}</td>
                <td class="rsv-num">{{ r.bookings }}</td>
                <td class="rsv-num">{% if r.requests %}<strong>{{ r.requests }}</strong>{% else %}0{% endif %}</td>
                <td class="rsv-actions">
                    <a href="{{ r.url_bookings }}">{{ t('BOOKINGS') }}<span class="rsv-sr">: {{ r.title }}</span></a>
                    <a href="{{ r.url_edit }}">{{ t('EDIT') }}<span class="rsv-sr">: {{ r.title }}</span></a>
                    {# running and future bookings or open requests keep an object; the core checks it again #}
                    {% if r.bookings == 0 and r.requests == 0 %}
                        <form action="{{ action }}" method="post" class="rsv-inline" onsubmit="return confirm('{{ t('CONFIRM_DELETE_RESOURCE')|e('js') }}')">
                            <input type="hidden" name="page_id" value="{{ page_id }}">
                            <input type="hidden" name="section_id" value="{{ section_id }}">
                            <input type="hidden" name="rsv_action" value="resource_delete">
                            <input type="hidden" name="resource_id" value="{{ r.id }}">
                            {{ FTAN|raw }}
                            <button type="submit" class="rsv-link">{{ t('DELETE') }}<span class="rsv-sr">: {{ r.title }}</span></button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="{{ news ? 8 : 7 }}">{{ t('NO_RESOURCES') }}</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <form class="rsv-form" action="{{ action }}" method="post">
        <input type="hidden" name="page_id" value="{{ page_id }}">
        <input type="hidden" name="section_id" value="{{ section_id }}">
        <input type="hidden" name="rsv_action" value="resource_save">
        <input type="hidden" name="resource_id" value="{{ form.resource_id }}">
        {{ FTAN|raw }}

        <fieldset>
            <legend>{{ form.resource_id ? t('EDIT_RESOURCE') : t('NEW_RESOURCE') }}</legend>
            <p>
                <label for="rsv-title-{{ section_id }}">{{ t('TITLE') }}</label>
                <input id="rsv-title-{{ section_id }}" type="text" name="title" value="{{ form.title }}" maxlength="255" required>
            </p>
            <p>
                <label for="rsv-type-{{ section_id }}">{{ t('TYPE') }}</label>
                <select id="rsv-type-{{ section_id }}" name="type_id">
                    {% for type in types %}
                        <option value="{{ type.id }}"{% if type.id == form.type_id %} selected{% endif %}>{{ type.title }}</option>
                    {% endfor %}
                </select>
            </p>
            <p>
                <label for="rsv-position-{{ section_id }}">{{ t('POSITION') }}</label>
                <input id="rsv-position-{{ section_id }}" type="number" name="position" value="{{ form.position }}" min="0" step="1" required>
            </p>
            {% if news %}
                <p>
                    <label for="rsv-post-{{ section_id }}">{{ t('DESCRIPTION') }}</label>
                    <select id="rsv-post-{{ section_id }}" name="post_id">
                        <option value="0">{{ t('NONE') }}</option>
                        {% for id, title in posts %}
                            <option value="{{ id }}"{% if id == form.post_id %} selected{% endif %}>{{ title }}</option>
                        {% endfor %}
                        {% if form.post_id and posts[form.post_id] is not defined %}
                            <option value="{{ form.post_id }}" selected>{{ t('DESCRIPTION_MISSING', form.post_id) }}</option>
                        {% endif %}
                    </select>
                </p>
            {% endif %}
            <p>
                <input id="rsv-active-{{ section_id }}" type="checkbox" name="active" value="1"{% if form.active %} checked{% endif %}>
                <label for="rsv-active-{{ section_id }}">{{ t('ACTIVE') }}</label>
            </p>
            {# new objects take the defaults of their type #}
            {% if form.resource_id %}
                {% include '_booking_rules.twig' with {rules: form, id: 'rsv-rules-' ~ section_id} %}
                {% if not whole_days %}
                    {# one text field per weekday: easier to fill in and to read aloud than 14 time inputs #}
                    <fieldset aria-describedby="rsv-hours-hint-{{ section_id }}">
                        <legend>{{ t('HOURS') }}</legend>
                        <small id="rsv-hours-hint-{{ section_id }}">{{ t('HOURS_HINT') }}</small>
                        {% for day, name in weekdays %}
                            <p>
                                <label for="rsv-hours-{{ day }}-{{ section_id }}">{{ name }}</label>
                                <input id="rsv-hours-{{ day }}-{{ section_id }}" type="text" name="hours[{{ day }}]" value="{{ form.hours[day] ?? '' }}" maxlength="100">
                            </p>
                        {% endfor %}
                        <small>{{ t('BLOCKED_TIMES_HINT') }}</small>
                    </fieldset>
                {% endif %}
            {% endif %}
            <p class="rsv-buttons">
                <button type="submit" class="button ico-save">{{ L_('TEXT:SAVE') }}</button>
                {% if form.resource_id %}<a href="{{ url_list }}">{{ L_('TEXT:CANCEL') }}</a>{% endif %}
            </p>
        </fieldset>
    </form>
</div>
