{
    "name": "webbird/reservations-core",
    "description": "CMS-unabhängiger Kern für Belegungs- und Reservierungskalender",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Bianka Martinovic",
            "email": "blackbird@webbird.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Reservations\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reservations\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
