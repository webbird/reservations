{#
    reservations/twig/view_plan.twig – occupancy plan, one table per month
#}
{% extends '_view_layout.twig' %}
{% block content %}
    {% for table in tables %}
        <div class="rsv-scroll" tabindex="0" role="region" aria-label="{{ t('PLAN') }} {{ table.caption }}">
            <table class="rsv-plan">
                <caption>{{ table.caption }}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{ t('RESOURCE') }}</th>
                        {% for day in table.days %}
                            <th scope="col"{% if day.weekend %} class="rsv-weekend"{% endif %} abbr="{{ day.long }}">
                                <span aria-hidden="true">{{ day.weekday }}<br>{{ day.number }}</span>
                                <span class="rsv-sr">{{ day.long }}</span>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                {% for row in table.rows %}
                    <tr>
                        <th scope="row">{% if row.url %}<a href="{{ row.url }}">{{ row.title }}</a>{% else %}{{ row.title }}{% endif %}</th>
                        {% for cell in row.cells %}
                            <td class="rsv-cell{{ cell.weekend ? ' rsv-weekend' }}"{% if cell.am or cell.pm or cell.outside %} title="{{ cell.text }}"{% endif %}>
                                {%- include '_cell.twig' -%}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endfor %}
{% endblock %}
