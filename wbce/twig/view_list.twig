{#
    reservations/twig/view_list.twig – occupied periods as a list, grouped by object
#}
{% extends '_view_layout.twig' %}
{% block content %}
    {% for group in groups %}
        <div class="rsv-group">
            {% if groups|length > 1 %}<h3 class="rsv-group-title">{% if group.url %}<a href="{{ group.url }}">{{ group.title }}</a>{% else %}{{ group.title }}{% endif %}</h3>{% endif %}
            {% if group.entries %}
                <ul class="rsv-list">
                    {% for e in group.entries %}
                        <li>
                            <span class="rsv-swatch rsv-pattern-{{ e.half.pattern }}" style="--rsv-color:{{ e.half.color }}" aria-hidden="true"></span>
                            <span class="rsv-range">{{ e.range }}</span>
                            <span>{{ e.text }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="rsv-empty">{{ t('NO_OCCUPANCY') }}</p>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
